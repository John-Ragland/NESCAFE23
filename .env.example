# Copy to .env (at the workspace root) and fill in the paths you have.
# Only NESCAFE23_DATADIR is required; `uv run nescafe23` can set it for you.

# NESCAFE23 experiment data (dmod/, environment_data/, dataproducts/)
NESCAFE23_DATADIR="/path/to/data/directory/"

# Optional: external or auxiliary datasets used by some nescafe23.data readers
NESCAFE23_COLOSI_PICKS_DIR="/path/to/colosi/picks/"
NESCAFE23_BATHY_25M_PATH="/path/to/bathymetry_25m.mat"
FCTD_DATA_DIR="/path/to/fctd/"
GLIDER_DATA="/path/to/glider.nc"
ARGO_DATA_DIR="/path/to/argo/"
COPERNICUS_SATELLITE_ALTIMETRY_PATH="/path/to/altimetry.nc"
WOA2023_PATH="/path/to/woa2023/"
